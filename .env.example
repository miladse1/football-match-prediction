# Copied to .env locally. Never commit .env.
# Generate a Fernet key: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=football_match_prediction
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Chronological split cutoffs and the fixture feed are DERIVED from today's
# date by football_pipeline.seasons, and roll forward on 1 August each year.
# Leave these unset for normal operation. Set them only to pin a historical
# window for a backfill or a reproducibility check.
# TRAIN_END=2024-07-31
# VALID_END=2025-07-31
# TEST_END=2026-07-31
# FIXTURES_URL=https://fixturedownload.com/feed/json/epl-2026
MIN_PRIOR_N=5
INGEST_START_YEAR=2018
# INGEST_END_YEAR=2026
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8500

AIRFLOW_ADMIN_USER=dev_admin
AIRFLOW_ADMIN_PASSWORD=change-me-local-password
AIRFLOW_FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
AIRFLOW_WEBSERVER_SECRET_KEY=replace-with-a-long-random-string
