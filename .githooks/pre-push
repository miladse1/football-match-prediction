#!/usr/bin/env bash
# Runs git-guard on every commit that is about to leave this computer.
# Git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
set -u
GUARD="$(git rev-parse --show-toplevel)/.githooks/guard.sh"
ZERO=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a remote branch
  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  else
    # New branch: check every commit that is not on the remote yet.
    oldest="$(git rev-list --reverse "$local_sha" --not --remotes | head -1)"
    [ -z "$oldest" ] && continue
    if parent="$(git rev-parse -q --verify "$oldest^" 2>/dev/null)"; then range="$parent..$local_sha"; else range="EMPTY..$local_sha"; fi
  fi
  "$GUARD" range "$range" || status=1
done
exit $status
